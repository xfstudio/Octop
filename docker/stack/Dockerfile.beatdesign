# syntax=docker/dockerfile:1
# Build with --build-context beatdesign_src=../BeatDesign (or a pinned Git URL).
ARG NODE_IMAGE=node:24-bookworm-slim
FROM ${NODE_IMAGE} AS apt-base
# Build-only helper uses official HTTPS repositories, signed APT metadata and
# SHA256-verified parallel downloads. The bind mount never enters the image.
RUN --mount=type=bind,source=docker/stack/install-debian-packages.mjs,target=/tmp/install-debian-packages.mjs,readonly \
    node /tmp/install-debian-packages.mjs --prepare

FROM ${NODE_IMAGE} AS build
WORKDIR /app
RUN corepack enable && corepack prepare pnpm@10.32.1 --activate
COPY --from=beatdesign_src /package.json /pnpm-lock.yaml /pnpm-workspace.yaml ./
COPY --from=beatdesign_src /src ./src
COPY --from=beatdesign_src /scripts ./scripts
COPY --from=beatdesign_src /tsconfig.json /vite.config.ts ./
COPY --from=beatdesign_src /messages ./messages
COPY --from=beatdesign_src /project.inlang ./project.inlang
COPY --from=beatdesign_src /public/app ./public/app
COPY --from=beatdesign_src /public/model-icons ./public/model-icons
COPY --from=beatdesign_src /public/logo.png /public/favicon.ico /public/apple-touch-icon.png ./public/
RUN --mount=type=cache,id=musae-beatdesign-pnpm,target=/pnpm/store \
    pnpm install --frozen-lockfile --store-dir=/pnpm/store
RUN pnpm build
RUN node --input-type=module <<'BUILD_MCP'
import { build } from 'esbuild';
await build({ entryPoints: ['scripts/mcp-server.ts'], outfile: 'mcp/server.mjs', bundle: true, platform: 'node', format: 'esm', target: 'node24', external: ['@libsql/client'], banner: { js: "import { createRequire as __stackRequire } from 'node:module'; const require = __stackRequire(import.meta.url);" } });
BUILD_MCP
RUN --mount=type=cache,id=musae-beatdesign-pnpm,target=/pnpm/store \
    CI=true pnpm --config.store-dir=/pnpm/store prune --prod

FROM apt-base AS runtime
ENV NODE_ENV=production BEATDESIGN_DATA_DIR=/var/lib/beatdesign BEATDESIGN_TOKEN_FILE=/run/stack-secrets/beatdesign-token
WORKDIR /app
RUN --mount=type=bind,source=docker/stack/install-debian-packages.mjs,target=/tmp/install-debian-packages.mjs,readonly \
    node /tmp/install-debian-packages.mjs ffmpeg ca-certificates \
    && rm -rf /var/lib/apt/lists/* && mkdir -p /var/lib/beatdesign && chown node:node /var/lib/beatdesign
COPY --from=build /app/package.json ./
COPY --from=build /app/node_modules ./node_modules
COPY --from=build /app/.output ./.output
COPY --from=build /app/mcp ./mcp
COPY --from=beatdesign_src /drizzle/sqlite ./drizzle/sqlite
COPY --from=beatdesign_src /skills ./skills
COPY --from=beatdesign_src /LICENSE ./LICENSE
COPY docker/stack/beatdesign-entry.mjs docker/stack/beatdesign-loopback-proxy.mjs ./stack/
USER node
EXPOSE 3020 3031
HEALTHCHECK --interval=20s --timeout=5s --start-period=30s CMD ["node", "--input-type=module", "-e", "const r = await fetch('http://127.0.0.1:3020/api/health'); if (!r.ok) process.exit(1)"]
CMD ["node", "stack/beatdesign-entry.mjs"]
